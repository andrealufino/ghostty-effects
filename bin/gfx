#!/bin/zsh
# gfx — switch Ghostty cursor effects on and off.
#
# The shaders live in this repo. gfx writes the active set to a small include
# file outside the repo and asks Ghostty to reload its config (SIGUSR2, the
# same as Cmd+Shift+,). Run `gfx help` for the commands.

emulate -L zsh
setopt no_unset pipe_fail extended_glob

SELF=${0:A}
ROOT=${SELF:h:h}
SHADERS=$ROOT/shaders
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/ghostty-effects
INCLUDE=$STATE/ghostty.conf
AGENT_LABEL=com.andrealufino.ghostty-effects.power
AGENT_PLIST=$HOME/Library/LaunchAgents/$AGENT_LABEL.plist
MARK="# --- Cursor effects (managed by gfx, see $ROOT) ---"

# Application order: ambient effects first, cursor effects last.
# Shaders not listed here are applied after these, alphabetically.
ORDER=(focus-line spotlight glide ripple sheen)

# ---------- helpers

die() { print -u2 -- "gfx: $*"; exit 1 }

ghostty_config() {
  local c
  for c in ${GHOSTTY_CONFIG:-} \
           $HOME/.config/ghostty/config.ghostty $HOME/.config/ghostty/config \
           "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty" \
           "$HOME/Library/Application Support/com.mitchellh.ghostty/config"; do
    [[ -n $c && -f $c ]] && { print -- $c; return }
  done
  return 1
}

available() {
  local -a all ordered
  local n
  all=($SHADERS/*.glsl(N:t:r))
  for n in $ORDER; do (( ${all[(Ie)$n]} )) && ordered+=($n); done
  for n in ${(o)all}; do (( ${ordered[(Ie)$n]} )) || ordered+=($n); done
  print -l -- $ordered
}

# First sentence of the shader's header comment, after the name.
describe() {
  local line text=""
  while IFS= read -r line; do
    [[ $line == //* ]] || break
    line=${${line#//}## #}
    [[ -n $line ]] || break
    text+="${text:+ }$line"
  done < $SHADERS/$1.glsl
  text=${${text#*— }%%. *}
  [[ $text == *. ]] || text+=.
  print -- ${(U)text[1]}${text[2,-1]}
}

selection() {
  [[ -s $STATE/selection ]] || return 0
  local -a sel=(${(f)"$(<$STATE/selection)"})
  local n
  for n in $(available); do (( ${sel[(Ie)$n]} )) && print -- $n; done
}

save_selection() {
  mkdir -p $STATE
  print -l -- "$@" > $STATE/selection
}

require_names() {
  local -a avail=($(available))
  local n
  (( $# )) || die "name at least one effect. Run 'gfx list'."
  for n in "$@"; do
    (( ${avail[(Ie)$n]} )) || die "unknown effect '$n'. Run 'gfx list'."
  done
}

validator() { print -- ${commands[glslangValidator]:-} }

# Compile shaders with Ghostty's own prefix. A broken shader can leave the
# window black, so anything that fails here is never handed to Ghostty.
compile_check() {
  local v=$(validator) n out tmp
  [[ -n $v ]] || return 0
  tmp=$(mktemp -d)
  for n in "$@"; do
    cat $ROOT/tools/ghostty-prefix.glsl $SHADERS/$n.glsl > $tmp/$n.frag
    if ! out=$($v -G -S frag -o /dev/null $tmp/$n.frag 2>&1); then
      rm -rf $tmp
      print -u2 -- "gfx: $n.glsl does not compile, nothing changed:"
      print -u2 -- ${out//$tmp\//}
      return 1
    fi
  done
  rm -rf $tmp
}

active() { [[ ! -e $STATE/off && ! -e $STATE/suspended ]] }

apply() {
  mkdir -p $STATE
  local -a lines=("# Generated by gfx. Edit with 'gfx', not by hand.")
  local n
  if active; then
    for n in $(selection); do lines+=("custom-shader = $SHADERS/$n.glsl"); done
  fi
  print -l -- $lines > $INCLUDE
  pkill -USR2 -x ghostty 2>/dev/null
  return 0
}

agent_loaded() { launchctl print gui/$UID/$AGENT_LABEL >/dev/null 2>&1 }

# ---------- commands

cmd_status() {
  local -a sel=($(selection))
  local n state
  if [[ -e $STATE/off ]]; then state="off"
  elif [[ -e $STATE/suspended ]]; then state="paused (on battery)"
  elif (( ${#sel} )); then state="on"
  else state="none selected"; fi
  print -- "Effects: $state"
  for n in $(available); do
    if (( ${sel[(Ie)$n]} )); then print -- "  ● ${(r:12:)n} $(describe $n)"
    else print -- "  ○ ${(r:12:)n} $(describe $n)"; fi
  done
  print -- "Battery saver: $(agent_loaded && print on || print off)"
  grep -qF -- "$INCLUDE" "$(ghostty_config 2>/dev/null)" 2>/dev/null \
    || print -- "Not installed in Ghostty yet: run 'gfx install'."
}

cmd_list() {
  local n
  for n in $(available); do print -- "${(r:12:)n} $(describe $n)"; done
}

cmd_set() {
  require_names "$@"
  compile_check "$@" || return 1
  save_selection "$@"
  rm -f $STATE/off
  apply; cmd_status
}

cmd_add() {
  require_names "$@"
  compile_check "$@" || return 1
  save_selection $(selection) "$@"
  rm -f $STATE/off
  apply; cmd_status
}

cmd_rm() {
  require_names "$@"
  local -a keep=($(selection))
  local n
  for n in "$@"; do keep=(${keep:#$n}); done
  save_selection $keep
  apply; cmd_status
}

cmd_on()  { mkdir -p $STATE; rm -f $STATE/off; apply; cmd_status }
cmd_off() { mkdir -p $STATE; touch $STATE/off; apply; print -- "Effects: off" }
cmd_toggle() { [[ -e $STATE/off ]] && cmd_on || cmd_off }

cmd_auto() {
  case ${1:-status} in
    on)
      mkdir -p ${AGENT_PLIST:h}
      cat > $AGENT_PLIST <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>$SELF</string><string>_power</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>$STATE/power.log</string>
</dict>
</plist>
EOF
      launchctl bootout gui/$UID/$AGENT_LABEL 2>/dev/null
      launchctl bootstrap gui/$UID $AGENT_PLIST || die "could not load the battery saver agent."
      print -- "Battery saver: on. Effects pause on battery and come back on power (checked every minute)." ;;
    off)
      launchctl bootout gui/$UID/$AGENT_LABEL 2>/dev/null
      rm -f $AGENT_PLIST
      if [[ -e $STATE/suspended ]]; then rm -f $STATE/suspended; apply; fi
      print -- "Battery saver: off." ;;
    status) print -- "Battery saver: $(agent_loaded && print on || print off)" ;;
    *) die "usage: gfx auto [on|off]" ;;
  esac
}

# Run by the battery saver agent.
cmd__power() {
  mkdir -p $STATE
  if [[ $(pmset -g ps | head -1) == *"Battery Power"* ]]; then
    [[ -e $STATE/suspended ]] || { touch $STATE/suspended; apply }
  else
    [[ -e $STATE/suspended ]] && { rm -f $STATE/suspended; apply }
  fi
  return 0
}

cmd_check() {
  local v=$(validator)
  [[ -n $v ]] || die "glslangValidator not found. Install it with: brew install glslang"
  local -a names=(${@:-$(available)})
  local n
  require_names $names
  for n in $names; do
    compile_check $n && print -- "ok    $n.glsl" || return 1
  done
}

cmd_preview() {
  local out=$ROOT/preview/shaders.js
  python3 - $SHADERS $out "$(selection | tr '\n' ' ')" $(available) <<'PY' || die "could not build the preview (python3 is needed)."
import json, pathlib, sys
shaders, out, active, names = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3].split(), sys.argv[4:]
effects = []
for name in names:
    src = (shaders / f"{name}.glsl").read_text()
    intro = []
    for line in src.splitlines():
        text = line.lstrip("/").strip()
        if not line.startswith("//") or not text:
            break
        intro.append(text)
    title, _, desc = " ".join(intro).partition(" — ")
    desc = desc[:1].upper() + desc[1:]
    effects.append({"id": name, "name": title, "desc": desc, "file": f"{name}.glsl", "src": src})
out.write_text("// Generated by `gfx preview`. Not tracked.\nwindow.GHOSTTY_EFFECTS = "
               + json.dumps({"effects": effects, "active": active}, ensure_ascii=False) + ";\n")
PY
  open $ROOT/preview/index.html
}

cmd_install() {
  local cfg
  cfg=$(ghostty_config) || die "Ghostty config not found. Set GHOSTTY_CONFIG to its path."
  mkdir -p $HOME/.local/bin $STATE
  ln -sf $SELF $HOME/.local/bin/gfx
  [[ -e $STATE/selection ]] || : > $STATE/selection
  if ! grep -qF -- "config-file = ?$INCLUDE" $cfg; then
    print -l -- "" "$MARK" "config-file = ?$INCLUDE" >> $cfg
    print -- "Added the effects include to ${cfg:A}"
  fi
  apply
  print -- "Linked gfx into ~/.local/bin."
  [[ -n $(validator) ]] || print -- "Tip: brew install glslang, so gfx can check shaders before Ghostty loads them."
  cmd_status
}

cmd_uninstall() {
  local cfg tmp
  cmd_auto off >/dev/null
  if cfg=$(ghostty_config); then
    tmp=$(mktemp)
    grep -vF -e "$MARK" -e "config-file = ?$INCLUDE" $cfg > $tmp
    cat $tmp > $cfg   # write in place, so a symlinked config stays a symlink
    rm -f $tmp
  fi
  [[ ${${:-$HOME/.local/bin/gfx}:A} == $SELF ]] && rm -f $HOME/.local/bin/gfx
  rm -rf $STATE
  pkill -USR2 -x ghostty 2>/dev/null
  print -- "Removed gfx from Ghostty. The repo itself is untouched."
}

cmd_help() {
  cat <<EOF
gfx — Ghostty cursor effects

  gfx                    show what is on
  gfx list               list the effects
  gfx set <fx...>        use exactly these effects
  gfx add <fx...>        add effects
  gfx rm <fx...>         remove effects
  gfx on | off | toggle  switch all effects, keeping the selection
  gfx auto [on|off]      pause effects on battery, resume on power
  gfx preview            open the interactive preview
  gfx check [fx...]      compile shaders with Ghostty's prefix (needs glslang)
  gfx install            hook gfx into the Ghostty config (once)
  gfx uninstall          remove the hook, agent and state

Effects: $(available | tr '\n' ' ')
EOF
}

# ---------- dispatch

cmd=${1:-status}
(( $# )) && shift
case $cmd in
  status|list|set|add|rm|on|off|toggle|auto|check|preview|install|uninstall|help|_power) cmd_$cmd "$@" ;;
  remove) cmd_rm "$@" ;;
  -h|--help) cmd_help ;;
  *) die "unknown command '$cmd'. Run 'gfx help'." ;;
esac
