#!/bin/zsh
# gfx — switch Ghostty cursor effects on and off.
#
# The shaders live in this repo. gfx writes the active set to a small include
# file outside the repo and asks Ghostty to reload its config (SIGUSR2, the
# same as Cmd+Shift+,). Run `gfx help` for the commands.

emulate -L zsh
setopt no_unset pipe_fail extended_glob

SELF=${0:A}
ROOT=${SELF:h:h}
SHADERS=$ROOT/shaders
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/ghostty-effects
INCLUDE=$STATE/ghostty.conf
AGENT_LABEL=com.andrealufino.ghostty-effects.power
AGENT_PLIST=$HOME/Library/LaunchAgents/$AGENT_LABEL.plist
MARK="# --- Cursor effects (managed by gfx, see $ROOT) ---"
CLAUDE_SETTINGS=${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}

# Application order: ambient effects first, cursor effects last.
# Shaders not listed here are applied after these, alphabetically.
ORDER=(focus-line spotlight focus-return claude-frame claude-rail shell-status glide ripple sheen)

# Claude Code status signal. The hooks write the state into palette slot 255
# as rgb(238, 237, 236 + state); the claude-* shaders decode it. Idle resets
# the slot to the theme's own colour.
CLAUDE_DONE_CURSOR="#9ece6a"   # brief cursor tint that timestamps the done flash
CLAUDE_DONE_HOLD=1.6           # seconds before done falls back to idle

# ---------- helpers

die() { print -u2 -- "gfx: $*"; exit 1 }

ghostty_config() {
  local c
  for c in ${GHOSTTY_CONFIG:-} \
           $HOME/.config/ghostty/config.ghostty $HOME/.config/ghostty/config \
           "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty" \
           "$HOME/Library/Application Support/com.mitchellh.ghostty/config"; do
    [[ -n $c && -f $c ]] && { print -- $c; return }
  done
  return 1
}

available() {
  local -a all ordered
  local n
  all=($SHADERS/*.glsl(N:t:r))
  for n in $ORDER; do (( ${all[(Ie)$n]} )) && ordered+=($n); done
  for n in ${(o)all}; do (( ${ordered[(Ie)$n]} )) || ordered+=($n); done
  print -l -- $ordered
}

# First sentence of the shader's header comment, after the name.
describe() {
  local line text=""
  while IFS= read -r line; do
    [[ $line == //* ]] || break
    line=${${line#//}## #}
    [[ -n $line ]] || break
    text+="${text:+ }$line"
  done < $SHADERS/$1.glsl
  text=${${text#*— }%%. *}
  [[ $text == *. ]] || text+=.
  print -- ${(U)text[1]}${text[2,-1]}
}

selection() {
  [[ -s $STATE/selection ]] || return 0
  local -a sel=(${(f)"$(<$STATE/selection)"})
  local n
  for n in $(available); do (( ${sel[(Ie)$n]} )) && print -- $n; done
}

save_selection() {
  mkdir -p $STATE
  print -l -- "$@" > $STATE/selection
}

require_names() {
  local -a avail=($(available))
  local n
  (( $# )) || die "name at least one effect. Run 'gfx list'."
  for n in "$@"; do
    (( ${avail[(Ie)$n]} )) || die "unknown effect '$n'. Run 'gfx list'."
  done
}

validator() { print -- ${commands[glslangValidator]:-} }

# Compile shaders with Ghostty's own prefix. A broken shader can leave the
# window black, so anything that fails here is never handed to Ghostty.
compile_check() {
  local v=$(validator) n out tmp
  [[ -n $v ]] || return 0
  tmp=$(mktemp -d)
  for n in "$@"; do
    cat $ROOT/tools/ghostty-prefix.glsl $SHADERS/$n.glsl > $tmp/$n.frag
    if ! out=$($v -G -S frag -o /dev/null $tmp/$n.frag 2>&1); then
      rm -rf $tmp
      print -u2 -- "gfx: $n.glsl does not compile, nothing changed:"
      print -u2 -- ${out//$tmp\//}
      return 1
    fi
  done
  rm -rf $tmp
}

active() { [[ ! -e $STATE/off && ! -e $STATE/suspended ]] }

# vec3(r, g, b) from a hex colour
hex_vec3() {
  local h=${1#\#}
  printf 'vec3(%.3f, %.3f, %.3f)' $(( 0x${h[1,2]} / 255.0 )) $(( 0x${h[3,4]} / 255.0 )) $(( 0x${h[5,6]} / 255.0 ))
}

effect_color() { [[ -s $STATE/color ]] && print -- $(<$STATE/color) }
cursor_color() { [[ -s $STATE/cursor ]] && print -- $(<$STATE/cursor) }

# The theme file Ghostty would load for a theme name.
theme_file() {
  local name=$1 d
  if [[ $name == /* ]]; then [[ -f $name ]] && print -- $name; return; fi
  for d in ${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/themes /Applications/Ghostty.app/Contents/Resources/ghostty/themes; do
    [[ -f $d/$name ]] && { print -- $d/$name; return 0 }
  done
  return 1
}

# Config lines for the cursor colour. One colour: a plain cursor-color line.
# Two colours: cursor-color has no light/dark form, so gfx derives the user's
# own light and dark themes with the cursor colour added and points theme at
# the copies. The copies are rebuilt from the main config on every gfx change.
cursor_lines() {
  local -a cur=($(cursor_color))
  (( ${#cur} == 2 )) || return 0
  if [[ $cur[1] == $cur[2] ]]; then print -- "cursor-color = #$cur[1]"; return 0; fi
  local cfg spec part mode name src out
  local -a pairs
  cfg=$(ghostty_config) || return 0
  spec=$(grep -E '^[[:space:]]*theme[[:space:]]*=' $cfg | tail -1)
  spec=${${${spec#*=}## #}%% #}; spec=${spec//\"/}
  if [[ $spec != *light:* || $spec != *dark:* ]]; then
    print -u2 -- "gfx: the Ghostty config has no light/dark theme pair, so the cursor uses #$cur[1]."
    print -- "cursor-color = #$cur[1]"; return 0
  fi
  mkdir -p $STATE/themes
  for part in ${(s:,:)spec}; do
    part=${${part## #}%% #}
    mode=${part%%:*}; name=${${part#*:}## #}
    src=$(theme_file $name) || { print -u2 -- "gfx: theme '$name' not found; cursor colour skipped."; return 0 }
    out=$STATE/themes/${name:t}-gfx
    { cat $src; print -- ""; print -- "# Added by gfx cursor"; print -- "cursor-color = #${cur[$([[ $mode == light ]] && print 2 || print 1)]}" } > $out
    pairs+=("$mode:$out")
  done
  print -- "theme = ${(j:,:)pairs}"
}

apply() {
  mkdir -p $STATE
  local -a lines=("# Generated by gfx. Edit with 'gfx', not by hand.")
  local -a tint=($(effect_color))
  local n
  rm -rf $STATE/shaders $STATE/themes
  lines+=(${(f)"$(cursor_lines)"})
  if active; then
    for n in $(selection); do
      if (( ${#tint} == 2 )); then
        # a copy with the colour injected, so the repo stays untouched
        mkdir -p $STATE/shaders
        {
          print -- "// Generated by gfx from $SHADERS/$n.glsl with 'gfx color'. Edit the original."
          print -- "#define GFX_TINT_DARK $(hex_vec3 $tint[1])"
          print -- "#define GFX_TINT_LIGHT $(hex_vec3 $tint[2])"
          cat $SHADERS/$n.glsl
        } > $STATE/shaders/$n.glsl
        lines+=("custom-shader = $STATE/shaders/$n.glsl")
      else
        lines+=("custom-shader = $SHADERS/$n.glsl")
      fi
    done
  fi
  print -l -- $lines > $INCLUDE
  pkill -USR2 -x ghostty 2>/dev/null
  return 0
}

agent_loaded() { launchctl print gui/$UID/$AGENT_LABEL >/dev/null 2>&1 }

# ---------- commands

cmd_status() {
  local -a sel=($(selection))
  local n state
  if [[ -e $STATE/off ]]; then state="off"
  elif [[ -e $STATE/suspended ]]; then state="paused (on battery)"
  elif (( ${#sel} )); then state="on"
  else state="none selected"; fi
  print -- "Effects: $state"
  for n in $(available); do
    if (( ${sel[(Ie)$n]} )); then print -- "  ● ${(r:12:)n} $(describe $n)"
    else print -- "  ○ ${(r:12:)n} $(describe $n)"; fi
  done
  print -- "Battery saver: $(agent_loaded && print on || print off)"
  print -- "Effect colour: $(describe_color)"
  print -- "Cursor colour: $(describe_cursor)"
  [[ -f $CLAUDE_SETTINGS ]] && cmd_claude status 2>/dev/null
  grep -qF -- "$INCLUDE" "$(ghostty_config 2>/dev/null)" 2>/dev/null \
    || print -- "Not installed in Ghostty yet: run 'gfx install'."
}

cmd_list() {
  local n
  for n in $(available); do print -- "${(r:12:)n} $(describe $n)"; done
}

cmd_set() {
  require_names "$@"
  compile_check "$@" || return 1
  save_selection "$@"
  rm -f $STATE/off
  apply; build_preview >/dev/null 2>&1; cmd_status
}

cmd_add() {
  require_names "$@"
  compile_check "$@" || return 1
  save_selection $(selection) "$@"
  rm -f $STATE/off
  apply; build_preview >/dev/null 2>&1; cmd_status
}

cmd_rm() {
  require_names "$@"
  local -a keep=($(selection))
  local n
  for n in "$@"; do keep=(${keep:#$n}); done
  save_selection $keep
  apply; build_preview >/dev/null 2>&1; cmd_status
}

describe_color() {
  local -a tint=($(effect_color))
  if (( ${#tint} != 2 )); then print -- "cursor colour (default)"
  elif [[ $tint[1] == $tint[2] ]]; then print -- "#$tint[1]"
  else print -- "#$tint[1] on dark themes, #$tint[2] on light themes"; fi
}

cmd_color() {
  case ${1:-} in
    "")
      print -- "Effect colour: $(describe_color)" ;;
    default|reset)
      rm -f $STATE/color; apply; build_preview >/dev/null 2>&1
      print -- "Effect colour: $(describe_color)" ;;
    *)
      local dark=${${1#\#}:l} light=${${${2:-$1}#\#}:l}
      [[ $dark == [0-9a-f](#c6) && $light == [0-9a-f](#c6) ]] \
        || die "use a hex colour like #9ccfd8 (and optionally a second one for light themes), or 'default'."
      mkdir -p $STATE
      print -- "$dark $light" > $STATE/color
      apply; build_preview >/dev/null 2>&1
      print -- "Effect colour: $(describe_color)" ;;
  esac
}

describe_cursor() {
  local -a cur=($(cursor_color))
  if (( ${#cur} != 2 )); then print -- "theme default"
  elif [[ $cur[1] == $cur[2] ]]; then print -- "#$cur[1]"
  else print -- "#$cur[1] on the dark theme, #$cur[2] on the light theme"; fi
}

cmd_cursor() {
  case ${1:-} in
    "")
      print -- "Cursor colour: $(describe_cursor)" ;;
    default|reset)
      rm -f $STATE/cursor; apply
      print -- "Cursor colour: $(describe_cursor)" ;;
    *)
      local dark=${${1#\#}:l} light=${${${2:-$1}#\#}:l}
      [[ $dark == [0-9a-f](#c6) && $light == [0-9a-f](#c6) ]] \
        || die "use a hex colour like #9ccfd8 (and optionally a second one for the light theme), or 'default'."
      mkdir -p $STATE
      print -- "$dark $light" > $STATE/cursor
      apply
      print -- "Cursor colour: $(describe_cursor)" ;;
  esac
}

cmd_on()  { mkdir -p $STATE; rm -f $STATE/off; apply; cmd_status }
cmd_off() { mkdir -p $STATE; touch $STATE/off; apply; print -- "Effects: off" }
cmd_toggle() { [[ -e $STATE/off ]] && cmd_on || cmd_off }

cmd_auto() {
  case ${1:-status} in
    on)
      mkdir -p ${AGENT_PLIST:h}
      cat > $AGENT_PLIST <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>$SELF</string><string>_power</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>$STATE/power.log</string>
</dict>
</plist>
EOF
      launchctl bootout gui/$UID/$AGENT_LABEL 2>/dev/null
      launchctl bootstrap gui/$UID $AGENT_PLIST || die "could not load the battery saver agent."
      print -- "Battery saver: on. Effects pause on battery and come back on power (checked every minute)." ;;
    off)
      launchctl bootout gui/$UID/$AGENT_LABEL 2>/dev/null
      rm -f $AGENT_PLIST
      if [[ -e $STATE/suspended ]]; then rm -f $STATE/suspended; apply; fi
      print -- "Battery saver: off." ;;
    status) print -- "Battery saver: $(agent_loaded && print on || print off)" ;;
    *) die "usage: gfx auto [on|off]" ;;
  esac
}

# Run by the battery saver agent.
cmd__power() {
  mkdir -p $STATE
  if [[ $(pmset -g ps | head -1) == *"Battery Power"* ]]; then
    [[ -e $STATE/suspended ]] || { touch $STATE/suspended; apply }
  else
    [[ -e $STATE/suspended ]] && { rm -f $STATE/suspended; apply }
  fi
  return 0
}

cmd_check() {
  build_preview >/dev/null 2>&1
  local v=$(validator)
  [[ -n $v ]] || die "glslangValidator not found. Install it with: brew install glslang"
  local -a names=(${@:-$(available)})
  local n
  require_names $names
  for n in $names; do
    compile_check $n && print -- "ok    $n.glsl" || return 1
  done
}

# Rebuild preview/shaders.js (tracked, so the page opens straight from a clone)
# and preview/state.js (untracked: the selection active in Ghostty).
build_preview() {
  (( $+commands[python3] )) || return 1
  python3 - $SHADERS $ROOT/preview "$(selection | tr '\n' ' ')" "$(effect_color)" $(available) <<'PY'
import json, pathlib, sys
shaders, preview, active, tint, names = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3].split(), sys.argv[4].split(), sys.argv[5:]
effects = []
for name in names:
    src = (shaders / f"{name}.glsl").read_text()
    intro = []
    for line in src.splitlines():
        text = line.lstrip("/").strip()
        if not line.startswith("//") or not text:
            break
        intro.append(text)
    title, _, desc = " ".join(intro).partition(" — ")
    desc = desc[:1].upper() + desc[1:]
    effects.append({"id": name, "name": title, "desc": desc, "file": f"{name}.glsl", "src": src})
js = "// Generated by gfx from shaders/. Do not edit.\nwindow.GHOSTTY_EFFECTS = " + json.dumps(effects, ensure_ascii=False, indent=1) + ";\n"
target = preview / "shaders.js"
if not target.exists() or target.read_text() != js:
    target.write_text(js)
tint = {"dark": "#" + tint[0], "light": "#" + tint[1]} if len(tint) == 2 else None
(preview / "state.js").write_text("// Generated by gfx. Not tracked.\nwindow.GHOSTTY_EFFECTS_ACTIVE = " + json.dumps(active)
                                  + ";\nwindow.GHOSTTY_EFFECTS_TINT = " + json.dumps(tint) + ";\n")
PY
}

cmd_preview() {
  build_preview || die "could not build the preview (python3 is needed)."
  open $ROOT/preview/index.html
}

cmd_install() {
  local cfg
  cfg=$(ghostty_config) || die "Ghostty config not found. Set GHOSTTY_CONFIG to its path."
  mkdir -p $HOME/.local/bin $STATE
  ln -sf $SELF $HOME/.local/bin/gfx
  [[ -e $STATE/selection ]] || : > $STATE/selection
  if ! grep -qF -- "config-file = ?$INCLUDE" $cfg; then
    print -l -- "" "$MARK" "config-file = ?$INCLUDE" >> $cfg
    print -- "Added the effects include to ${cfg:A}"
  fi
  apply
  print -- "Linked gfx into ~/.local/bin."
  [[ -n $(validator) ]] || print -- "Tip: brew install glslang, so gfx can check shaders before Ghostty loads them."
  cmd_status
}

cmd_uninstall() {
  local cfg tmp
  cmd_auto off >/dev/null
  [[ -f $CLAUDE_SETTINGS ]] && cmd_claude off >/dev/null
  if cfg=$(ghostty_config); then
    tmp=$(mktemp)
    grep -vF -e "$MARK" -e "config-file = ?$INCLUDE" $cfg > $tmp
    cat $tmp > $cfg   # write in place, so a symlinked config stays a symlink
    rm -f $tmp
  fi
  [[ ${${:-$HOME/.local/bin/gfx}:A} == $SELF ]] && rm -f $HOME/.local/bin/gfx
  rm -rf $STATE
  pkill -USR2 -x ghostty 2>/dev/null
  print -- "Removed gfx from Ghostty. The repo itself is untouched."
}

# ---------- Claude Code status

# The terminal of the Claude Code session that ran this hook. Hooks have no
# controlling terminal of their own, so walk up the process tree to the first
# ancestor attached to one.
claude_tty() {
  local p=$PPID t i
  for i in {1..10}; do
    t=${$(ps -o tty= -p $p 2>/dev/null)// /}
    if [[ -n $t && $t != '??' && -w /dev/$t ]]; then print -- /dev/$t; return 0; fi
    p=${$(ps -o ppid= -p $p 2>/dev/null)// /}
    [[ -n $p && $p != 0 && $p != 1 ]] || break
  done
  return 1
}

# Run by the Claude Code hooks: writes the state for the claude-* shaders
# straight to the session's terminal. (Claude Code's own `terminalSequence`
# field only passes title sequences and ignores async hooks.)
cmd_hook() {
  local event=${1:-} input sid sfile tty
  input=$(cat 2>/dev/null)
  sid=$(print -r -- "$input" | jq -r '.session_id // empty' 2>/dev/null)
  sid=${${sid:-default}//[^A-Za-z0-9_-]/}
  mkdir -p $STATE/claude
  sfile=$STATE/claude/$sid
  tty=$(claude_tty) || return 0
  emit() { print -rn -- "$1" > $tty 2>/dev/null }
  slot() { printf '\e]4;255;rgb:ee/ed/%02x\a' $(( 236 + $1 )) }
  case $event in
    idle)
      rm -f $sfile; emit $'\e]104;255\a\e]112\a' ;;
    working)
      print working > $sfile; emit "$(slot 1)" ;;
    waiting)
      print waiting > $sfile; emit "$(slot 2)" ;;
    done)
      # a brief cursor tint timestamps the flash (iTimeCursorChange)
      print done > $sfile
      emit "$(slot 3)"$'\e]12;'"$CLAUDE_DONE_CURSOR"$'\a'
      sleep 0.12
      emit $'\e]112\a'
      sleep $CLAUDE_DONE_HOLD
      if [[ -f $sfile && $(<$sfile) == done ]]; then rm -f $sfile; emit $'\e]104;255\a'; fi ;;
    *) die "usage: gfx hook idle|working|waiting|done" ;;
  esac
  # forget sessions that ended without a SessionEnd
  local -a stale=($STATE/claude/*(N.mh+24))
  (( ${#stale} )) && rm -f $stale
  return 0
}

# Add or remove the gfx hooks in Claude Code's settings. Every gfx entry runs
# `gfx hook`, so removal finds exactly those and leaves everything else alone.
cmd_claude() {
  local action=${1:-status}
  case $action in
    on|off|status) ;;
    *) die "usage: gfx claude [on|off]" ;;
  esac
  [[ -f $CLAUDE_SETTINGS ]] || die "Claude Code settings not found at $CLAUDE_SETTINGS."
  (( $+commands[jq] )) || die "jq is needed for the Claude Code hooks (brew install jq)."
  python3 - $CLAUDE_SETTINGS $action <<'PY' || die "could not update $CLAUDE_SETTINGS."
import json, sys
path, action = sys.argv[1], sys.argv[2]
CMD = "~/.local/bin/gfx hook "
WANTED = [  # (event, matcher, state)
    ("SessionStart", "", "idle"),
    ("UserPromptSubmit", "", "working"),
    ("PreToolUse", "", "working"),
    ("PostToolUse", "", "working"),
    ("Notification", "permission_prompt", "waiting"),
    ("Stop", "", "done"),
    ("SessionEnd", "", "idle"),
]
with open(path, encoding="utf-8") as f:
    settings = json.load(f)
hooks = settings.setdefault("hooks", {})

def ours(h):
    return h.get("type") == "command" and h.get("command", "").startswith(CMD)

installed = sum(1 for groups in hooks.values() for g in groups for h in g.get("hooks", []) if ours(h))
if action == "status":
    print("Claude Code hooks: " + ("on" if installed else "off"))
    sys.exit(0)

# drop existing gfx entries, and any group they leave empty
for event in list(hooks):
    groups = []
    for g in hooks[event]:
        g["hooks"] = [h for h in g.get("hooks", []) if not ours(h)]
        if g["hooks"]:
            groups.append(g)
    if groups:
        hooks[event] = groups
    else:
        del hooks[event]

if action == "on":
    for event, matcher, state in WANTED:
        hooks.setdefault(event, []).append({
            "matcher": matcher,
            "hooks": [{"type": "command", "command": CMD + state, "async": True, "timeout": 5}],
        })
if not hooks:
    del settings["hooks"]

text = json.dumps(settings, indent=2, ensure_ascii=False) + "\n"
with open(path, "w", encoding="utf-8") as f:   # in place: keeps links and ownership
    f.write(text)
print("Claude Code hooks: " + action + ("" if action == "off" else ". Takes effect in new Claude Code sessions."))
PY
}

# ---------- shell status

# The shell-status effect needs a few zsh hooks; they live in shell/ and are
# sourced from .zshrc, which gfx leaves for you to edit.
cmd_shell() {
  local rc=${ZDOTDIR:-$HOME}/.zshrc
  if grep -qF -- "ghostty-effects/shell/gfx-status.zsh" $rc 2>/dev/null; then
    print -- "Shell status: sourced from ${rc/#$HOME/~}."
  else
    print -- "Shell status: not set up. Add this line to ${rc/#$HOME/~}, then open a new tab:"
    print -- "  source $ROOT/shell/gfx-status.zsh"
  fi
}

cmd_help() {
  cat <<EOF
gfx — Ghostty cursor effects

  gfx                    show what is on
  gfx list               list the effects
  gfx set <fx...>        use exactly these effects
  gfx add <fx...>        add effects
  gfx rm <fx...>         remove effects
  gfx on | off | toggle  switch all effects, keeping the selection
  gfx color [#dark [#light]|default]
                         effect colour: one for both themes, or one each;
                         default follows the cursor colour
  gfx cursor [#dark [#light]|default]
                         cursor colour, the same way; default is the theme's
  gfx auto [on|off]      pause effects on battery, resume on power
  gfx claude [on|off]    Claude Code hooks for the claude-* effects
  gfx shell              zsh hooks for the shell-status effect
  gfx preview            open the interactive preview
  gfx check [fx...]      compile shaders with Ghostty's prefix (needs glslang)
  gfx install            hook gfx into the Ghostty config (once)
  gfx uninstall          remove the hook, agent and state

Effects: $(available | tr '\n' ' ')
EOF
}

# ---------- dispatch

cmd=${1:-status}
(( $# )) && shift
case $cmd in
  status|list|set|add|rm|on|off|toggle|color|cursor|auto|claude|shell|hook|check|preview|install|uninstall|help|_power) cmd_$cmd "$@" ;;
  remove) cmd_rm "$@" ;;
  -h|--help) cmd_help ;;
  *) die "unknown command '$cmd'. Run 'gfx help'." ;;
esac
